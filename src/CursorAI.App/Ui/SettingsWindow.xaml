<Window x:Class="CursorAI.App.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CursorAI Settings"
        Width="600"
        SizeToContent="Height"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Background="#252238"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Vision provider credentials" Foreground="White"
                   FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" Foreground="#9A95B8" FontSize="11" TextWrapping="Wrap"
                   Margin="0,0,0,14"
                   Text="Keys are encrypted for your Windows account and stored under %LOCALAPPDATA%\CursorAI. A free Gemini key can be created at aistudio.google.com/apikey." />

        <TextBlock Grid.Row="2" Text="Gemini API key" Foreground="#C9C5E0" FontSize="12" Margin="0,0,0,4" />
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <PasswordBox x:Name="GeminiKeyBox" Height="28" FontSize="12" Padding="6,4,6,4" />
            <TextBox x:Name="GeminiKeyPlain" Height="28" FontSize="12" Padding="6,4,6,4"
                     Visibility="Collapsed" />
        </Grid>

        <TextBlock Grid.Row="4" Text="OpenAI API key (only used if the OpenAI provider is selected)"
                   Foreground="#C9C5E0" FontSize="12" Margin="0,0,0,4" />
        <PasswordBox Grid.Row="5" x:Name="OpenAiKeyBox" Height="28" FontSize="12"
                     Padding="6,4,6,4" Margin="0,0,0,12" />

        <Grid Grid.Row="6" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Provider" Foreground="#C9C5E0" FontSize="12" Margin="0,0,0,4" />
                <ComboBox x:Name="ProviderBox" Height="26" FontSize="12">
                    <ComboBoxItem Content="gemini" />
                    <ComboBoxItem Content="openai" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Gemini model (blank for default)" Foreground="#C9C5E0"
                           FontSize="12" Margin="0,0,0,4" />
                <TextBox x:Name="ModelBox" Height="26" FontSize="12" Padding="6,3,6,3" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="OpenAI model (blank for default)" Foreground="#C9C5E0"
                           FontSize="12" Margin="0,0,0,4" />
                <TextBox x:Name="OpenAiModelBox" Height="26" FontSize="12" Padding="6,3,6,3" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="7" Foreground="#9A95B8" FontSize="11" TextWrapping="Wrap"
                   Margin="0,0,0,14"
                   Text="A provider change takes effect the next time CursorAI starts. Keys and models apply to the next request." />

        <TextBlock Grid.Row="8" x:Name="StatusText" Foreground="#FF9F43" FontSize="11"
                   TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed" />

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
            <CheckBox x:Name="ShowKeyBox" Content="Show key" Foreground="#9A95B8" FontSize="11"
                      VerticalAlignment="Center" Margin="0,0,16,0"
                      Checked="ShowKeyBox_Changed" Unchecked="ShowKeyBox_Changed" />
            <Button x:Name="CancelButton" Content="Cancel" Width="84" Height="28"
                    Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button x:Name="SaveButton" Content="Save" Width="84" Height="28"
                    Click="SaveButton_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
