<Window x:Class="CursorAI.App.Ui.ConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CursorAI - what leaves your machine"
        Width="600"
        SizeToContent="Height"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Background="#252238"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Before you start" Foreground="White"
                   FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />

        <Border Grid.Row="1" Background="#1A1828" CornerRadius="6" Padding="14"
                Margin="0,0,0,16">
            <TextBlock x:Name="DisclosureText" Foreground="#D6D2EC" FontSize="12"
                       LineHeight="18" TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="DeclineButton" Content="Decline (local only)" Width="150" Height="30"
                    Margin="0,0,10,0" Click="DeclineButton_Click" IsCancel="True" />
            <Button x:Name="AcceptButton" Content="I understand, continue" Width="170" Height="30"
                    Click="AcceptButton_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
