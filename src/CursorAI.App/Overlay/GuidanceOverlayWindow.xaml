<Window x:Class="CursorAI.App.Overlay.GuidanceOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CursorAI Guidance"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <Storyboard x:Key="HighlightPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="TargetLayer"
                             Storyboard.TargetProperty="Opacity"
                             From="0.55" To="1" Duration="0:0:0.9" />
        </Storyboard>
    </Window.Resources>

    <Canvas x:Name="TargetLayer" Background="Transparent" />
</Window>
