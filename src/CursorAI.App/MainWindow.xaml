<Window x:Class="CursorAI.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CursorAI Buddy"
        Width="64"
        Height="64"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Grid Background="Transparent">
        <Ellipse Margin="4"
                 Fill="#6C63FF"
                 Stroke="White"
                 StrokeThickness="2" />

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
            <Grid Width="16" Height="20" Margin="0,0,3,0">
                <Ellipse Fill="White" />
                <Ellipse Width="6" Height="8" Fill="#252238" />
            </Grid>
            <Grid Width="16" Height="20" Margin="3,0,0,0">
                <Ellipse Fill="White" />
                <Ellipse Width="6" Height="8" Fill="#252238" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
