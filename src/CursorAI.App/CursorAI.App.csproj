<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>cursorai.ico</ApplicationIcon>

    <!-- Identity, so an installed build is not a nameless exe in Task Manager. -->
    <AssemblyTitle>CursorAI</AssemblyTitle>
    <Product>CursorAI</Product>
    <Company>CursorAI</Company>
    <Description>Windows AI desktop companion that sees what your cursor points at.</Description>
    <Copyright>Copyright (c) 2026 Samuel Onyema</Copyright>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <!--
    Publish profile for sharing with testers. Self-contained so no .NET runtime install is
    needed, single-file so there is one thing to copy, and compression because WPF plus a
    self-contained runtime is otherwise large.
    ReadyToRun is deliberately off: it roughly doubles output size for a startup win that does
    not matter for an app that sits idle waiting for a hotkey.
  -->
  <PropertyGroup Condition="'$(PublishProfileActive)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.GenAI" Version="1.21.1" />
    <PackageReference Include="NAudio" Version="3.1.0" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <PackageReference Include="System.Speech" Version="10.0.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

</Project>
