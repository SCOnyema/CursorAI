<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- For NotifyIcon only. The raw Shell_NotifyIcon path needs a message-only window
         and menu interop, because the buddy is WS_EX_NOACTIVATE and click-through. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>cursorai.ico</ApplicationIcon>

    <!--
      WFO0003 asks for DPI to be configured through ApplicationHighDpiMode instead of the
      manifest. Suppressed deliberately: the manifest declaration is load-bearing for the
      capture path, which treats GetCursorPos, GetMonitorInfo and BitBlt output as true
      physical pixels, and it is verified to produce PROCESS_PER_MONITOR_DPI_AWARE - including
      in the published build after WinForms was added for the tray icon. ApplicationHighDpiMode
      is a WinForms mechanism and WinForms here is one notification-area icon, so taking its
      advice would trade a verified behaviour for an unverified one.
    -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>

    <!-- Identity, so an installed build is not a nameless exe in Task Manager. -->
    <AssemblyTitle>CursorAI</AssemblyTitle>
    <Product>CursorAI</Product>
    <Company>CursorAI</Company>
    <Description>Windows AI desktop companion that sees what your cursor points at.</Description>
    <Copyright>Copyright (c) 2026 Samuel Onyema</Copyright>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <!--
    Publish profile for sharing with testers. Self-contained so no .NET runtime install is
    needed, single-file so there is one thing to copy, and compression because WPF plus a
    self-contained runtime is otherwise large.
    ReadyToRun is deliberately off: it roughly doubles output size for a startup win that does
    not matter for an app that sits idle waiting for a hotkey.
  -->
  <PropertyGroup Condition="'$(PublishProfileActive)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so a single-file published build can load it with no file beside the exe. -->
    <EmbeddedResource Include="cursorai.ico" />
  </ItemGroup>

  <!--
    UseWindowsForms adds these as implicit global usings, which then collide with WPF's Point,
    Size, Application and KeyEventArgs across the whole project. Only the tray icon needs
    WinForms, and it imports them explicitly.
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.GenAI" Version="1.21.1" />
    <PackageReference Include="NAudio" Version="3.1.0" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <PackageReference Include="System.Speech" Version="10.0.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

</Project>
